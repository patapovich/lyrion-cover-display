[Unit]
Description=Lyrion Cover Display (kiosk album art screen)
# Start as early as possible: the app only needs the rootfs (for its assets) and
# writes the firmware framebuffer (/dev/fb0) directly — it does NOT use DRM/KMS
# (vc4 is disabled, so /dev/dri never appears). Do NOT depend on
# dev-dri-card0.device: that device never shows, so Wants+After on it stalls boot
# ~90s on DefaultDeviceTimeoutSec. No network-online wait either: the app
# polls/retries LMS itself.
# Early start: skip the default sysinit/basic.target wait (~2.4s on this Pi).
# Everything the app touches is up long before those: the rootfs (/usr, /home)
# is mounted before systemd runs, /dev/fb0 comes from devtmpfs + the built-in
# fb driver, and stdout goes to the journald socket. DefaultDependencies=no
# drops the implicit After=basic.target; order only after journald + the
# local-fs preparation point, and keep an explicit clean-shutdown conflict
# (normally implied) so SIGTERM cleanup still runs on reboot/poweroff.
DefaultDependencies=no
After=local-fs-pre.target systemd-journald.socket
Wants=local-fs-pre.target
Conflicts=getty@tty1.service shutdown.target
Before=shutdown.target
# Never give up: a kiosk must self-heal, never sit dark. systemd's default
# rate-limit (5 starts/10s) would drop it into a permanent failed state on a
# crash loop; 0 disables that so it keeps retrying through transient faults.
StartLimitIntervalSec=0

[Service]
Type=simple
# Starting before udev's coldplug means /dev/fb0 and /dev/vchiq may still have
# their bare devtmpfs permissions (root-only), which would crash the un-priv
# user's first open into a restart loop. Grant the video group up front ('+'
# runs this one line as root); udev applies the same group moments later.
ExecStartPre=+/bin/sh -c 'chgrp video /dev/fb0 /dev/vchiq 2>/dev/null; chmod g+rw /dev/fb0 /dev/vchiq 2>/dev/null; true'
# install.sh substitutes the real user/paths into the installed copy.
User=__USER__
WorkingDirectory=__APPDIR__
Environment=SDL_VIDEODRIVER=dummy
Environment=SDL_AUDIODRIVER=dummy
ExecStart=/usr/bin/python3 __APPDIR__/lms_cover_display.py
# Run on tty1 so KMS/DRM has a console to grab.
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=5
# SIGTERM cleanup is instant (finally-block); cap the worst case so a restart
# never freezes the panel for systemd's 90s default.
TimeoutStopSec=10
# Safety on the 512MB Pi: OOM-kill our own process (-> restart) rather than a
# random victim. Resident is ~50-80MB, so this is generous headroom.
MemoryMax=256M

[Install]
WantedBy=multi-user.target
